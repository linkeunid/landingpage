{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "landingpage",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	// apex 301s to www in hooks.server.ts; only www is indexed (site.prodHost)
	"routes": [
		{ "pattern": "www.linkeun.com", "custom_domain": true },
		{ "pattern": "linkeun.com", "custom_domain": true }
	],
	"env": {
		"beta": {
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "beta.linkeun.com", "custom_domain": true }]
		}
	}
}
